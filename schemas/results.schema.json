{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "results.json — CONTRACT 2 (benchmark → app handoff)",
  "description": "Three scores per rung per domain: determinism, accuracy, cost. Benchmark writes it; app reads it.",
  "type": "object",
  "properties": {
    "model": { "type": "string" },
    "temperature": { "type": "number" },
    "k_runs": { "type": "integer", "description": "times each input was run to measure determinism" },
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "n_items": { "type": "integer" },
          "rungs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "rung": { "type": "integer", "minimum": 0, "maximum": 6 },
                "name": { "type": "string" },
                "determinism": {
                  "type": "object",
                  "description": "field-level exact-match agreement across k_runs (0-1)",
                  "properties": {
                    "field_agreement": { "type": "number" },
                    "delta": { "type": "number" },
                    "ci_low": { "type": "number" },
                    "ci_high": { "type": "number" }
                  },
                  "required": ["field_agreement", "delta"]
                },
                "accuracy": {
                  "type": "object",
                  "properties": {
                    "accuracy_on_answered": { "type": "number" },
                    "coverage": { "type": "number" },
                    "delta": { "type": "number" },
                    "ci_low": { "type": "number" },
                    "ci_high": { "type": "number" }
                  },
                  "required": ["accuracy_on_answered", "coverage", "delta"]
                },
                "cost": {
                  "type": "object",
                  "properties": {
                    "tokens": { "type": "integer" },
                    "dollars": { "type": "number" },
                    "latency_s": { "type": "number" },
                    "human_minutes": { "type": "number" },
                    "delta_dollars": { "type": "number" }
                  },
                  "required": ["dollars", "delta_dollars"]
                }
              },
              "required": ["rung", "name", "determinism", "accuracy", "cost"]
            }
          }
        },
        "required": ["name", "n_items", "rungs"]
      }
    }
  },
  "required": ["model", "k_runs", "domains"]
}
