# NOTE: `#` only starts a comment at the START of a line. A trailing comment is
# part of the pattern, so `data/*_v1.json   # built datasets` ignores nothing.
# Every comment here is on its own line for that reason.

# ── LICENCE-CRITICAL ────────────────────────────────────────────────
# CADEC is non-commercial and NON-TRANSFERABLE. No redistribution, ever —
# not in the repo, not in a release asset, not in a notebook output cell.
# See docs/licences.md. `scripts/preflight.py` enforces this before a push.
data/cadec
data/cadec/
data/CADEC*
data/CADEC*/
data/private*
# the CADEC v3 download, as CSIRO ships it
data/2016-04-15_Karimi_Sarvnaz_*
# built datasets embed document text
data/*_v1.json

# MedDRA is subscription-licensed, and the 666-row list that ships inside CADEC
# is a substantial extract covered by CADEC's terms either way. Commit the
# 10-row example; never the full list.
data/meddra_codes.csv

# SNOMED CT release files — affiliate licence, and 5 GB besides. The derived
# SQLite index is the same content in another shape, so it goes too.
data/SnomedCT_Release_*
ladder/cache/

# data/splits/ is deliberately NOT ignored: document IDs only, no post text and
# no annotations. The frozen split has to survive or iteration 2 cannot be
# compared to iteration 1.

# ── CACHES: large, and they contain document text ───────────────────
.llm_cache/
cache/
.vocab_cache/

# ── RUN OUTPUT: changes every run, merges are meaningless ───────────
results/
results.json
*.outputs.jsonl
# the one committed run the hosted app reads
!app/results.reference.json
# out/ carries worked examples, and a worked example is a corpus quotation
out/

# ── SECRETS ─────────────────────────────────────────────────────────
.env
.env.*
.streamlit/secrets.toml
*.key

# ── PYTHON ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyc
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/
# notebook OUTPUT CELLS are the classic leak. Strip them, or exclude the file.
*.ipynb

# ── OS / MISC ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log
data/raw/

# ── GITLAB ──────────────────────────────────────────────────────────
# public/ is built by the pages CI job and never committed
public/
.pipcache/
data/*
!data/splits/
!data/splits/**

# Generated wiki output. Source is docs/wiki/content/; rebuild with
# python docs/wiki/build.py
docs/wiki/site/
*.bak
runs/*.ledger.jsonl
runs/*.report.txt
runs/.r6-pool.json
