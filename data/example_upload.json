{
  "domain": "example_invoices",
  "prompt": "Extract the total amount, invoice date, and vendor name from the invoice text.",
  "output_schema": {
    "type": "object",
    "properties": {
      "total": { "type": "number", "format": "currency" },
      "date": { "type": "string", "format": "date" },
      "vendor": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "city": { "type": "string" }
        }
      }
    },
    "required": ["total", "date"]
  },
  "economics": {
    "value_correct": 1.0,
    "cost_wrong": 10.0,
    "cost_abstain": 0.5,
    "dollars_per_human_min": 1.0
  },
  "items": [
    {
      "doc": "INVOICE\nAcme Supplies, Springfield\nDate: 2024-01-15\nTotal due: $42.00",
      "gold": {
        "total": 42.0,
        "date": "2024-01-15",
        "vendor": { "name": "Acme Supplies", "city": "Springfield" }
      },
      "trusted_record": { "total": "42.00", "date": "2024-01-15" }
    },
    {
      "doc": "INVOICE\nBeta Corp, Shelbyville\nDate: 2024-02-20\nTotal due: $99.50",
      "gold": {
        "total": 99.5,
        "date": "2024-02-20",
        "vendor": { "name": "Beta Corp", "city": "Shelbyville" }
      }
    }
  ]
}
