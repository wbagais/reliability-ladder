// VERDICT FLOW. Redrawn twice on 2026-09-03.
//
// RULE FOR THIS FIGURE, and it is the owner's: an arrow exists only where a rung
// genuinely READS or WRITES. Execution order is not a link and is not drawn — the
// previous version drew it as a dotted spine, which made it look as though the
// judge consumes the vote. It does not.
//
// Rung 0 is absent because it writes no verdict; it produces the records every
// rung then operates on. Rung 4's read of `r1_verdict` is NOT drawn: it happens
// (r4.py:267) but only to build the aggregate report, never to judge.
// `r4_verdict` has a reader ONLY under `abstain_on_judge_fail`, which is off in
// the shipped configuration — drawn dashed and labelled as such.
//
// Sources: r1 writes (r1.py) · r2 reads as its trigger (r2.py:347) and rewrites
// (r2.py:451) · r3 rewrites (r3.py:218) · r5 reads (r5.py:82) · r6 takes r5's
// ABSTAIN residue with checks.withheld (r6.py:94).
digraph verdicts {
  rankdir=TB; bgcolor="white"; ranksep=0.55; nodesep=0.4;
  node [shape=box style="filled,rounded" fontname="Helvetica" fontsize=11
        fillcolor="#eef1f2" color="#c8d1d5" penwidth=1.2];
  edge [fontname="Helvetica" fontsize=9 arrowsize=0.8];

  R1 [label="1 · check\nfree" fillcolor="#e3f0e6" color="#2d6a4f" penwidth=2];
  R2 [label="2 · self-correct"];
  R3 [label="3 · vote"];
  R4 [label="4 · judge" fillcolor="#f7e3e3" color="#a33333" penwidth=2];
  R5 [label="5 · refuse" fillcolor="#e3f0e6" color="#2d6a4f" penwidth=2];
  R6 [label="6 · person"];

  V [label="r1_verdict\nACCEPT · BAND · REJECT" style=filled fillcolor="#e3f0e6"
     color="#2d6a4f" penwidth=2.5 shape=box];
  D2 [label="r2_declined" style=filled fillcolor="#f7e3e3" color="#a33333" penwidth=1.6 fontsize=10];
  D3 [label="r3_unanimous_none" style=filled fillcolor="#f7e3e3" color="#a33333" penwidth=1.6 fontsize=10];
  D4 [label="r4_verdict" style=filled fillcolor="#f7e3e3" color="#a33333" penwidth=1.6 fontsize=10];
  NR [label="no reader" shape=plaintext fontcolor="#a33333" fontsize=11];

  R1 -> V  [color="#2d6a4f" penwidth=2.4 label="writes"];
  V  -> R2 [color="#2d6a4f" penwidth=2.0 label="reads — its only trigger"];
  R2 -> V  [color="#2d6a4f" penwidth=2.0 label="re-runs the check, overwrites"];
  R3 -> V  [color="#2d6a4f" penwidth=2.0 label="re-runs the check, overwrites"];
  V  -> R5 [color="#2d6a4f" penwidth=3.0 label="reads — the whole decision"];
  R5 -> R6 [color="#2d6a4f" penwidth=2.4 label="the withheld queue"];

  R2 -> D2 [color="#a33333" penwidth=1.6 style=dashed];
  R3 -> D3 [color="#a33333" penwidth=1.6 style=dashed];
  R4 -> D4 [color="#a33333" penwidth=1.6 style=dashed];
  D2 -> NR [color="#a33333" penwidth=1.4 style=dashed];
  D3 -> NR [color="#a33333" penwidth=1.4 style=dashed];
  D4 -> NR [color="#a33333" penwidth=1.4 style=dashed
            label="unless abstain_on_judge_fail,\lwhich ships off\l" fontcolor="#a33333"];

  note [shape=none margin=0 label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3">
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">An arrow is a read or a write. Execution order is not drawn, because it moves no verdict.</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Rung 0 is absent: it writes no verdict, it produces the records every rung operates on.</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><B>The judge touches nothing.</B> It writes a verdict with no reader and its own reading of</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><FONT FACE="Courier">r1_verdict</FONT> feeds a report, never a decision — so it is drawn with no incoming arrow at all.</FONT></TD></TR>
    </TABLE>>];
  NR -> note [style=invis];
  {rank=same; D2; D3; D4;}
}
