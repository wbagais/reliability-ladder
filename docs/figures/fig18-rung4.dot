// Rung 4 on both corpora. One model call per record; the judge is required to be
// a different family from the extractor, enforced in run.py.
//
// THE BLIND JUDGE AS SHIPPED, on the base run (2026-09-03): CADEC
// rerun-cadec-d0 (230 records) pass 136 / fail 87 / 7 unjudged; FiNER
// rerun-finer-d0 (304) pass 45 / fail 251 / 8 unjudged, decomposed to
// (span_ok, code_ok). Each panel is ONE run and says which. The judge here was
// handed a bare code and no menu; the menu-shown judge (rungs.4.menu) is the
// table in article section 6, and it supersedes these counts.
//
// COLOUR KEY — the article's: teal a model runs here · green pass · red fail
digraph rung4 {
  rankdir=TB; bgcolor="white"; nodesep=0.30; ranksep=0.34;
  node [shape=box style="filled,rounded" fontname="Helvetica" fontsize=11.5
        color="#c8d1d5" penwidth=1.2];
  edge [color="#b3bec3" penwidth=1.5 arrowsize=0.7 fontname="Helvetica" fontsize=10];

  in [label="EVERY record, every lane\n+ the whole source text"
      fillcolor="#eef1f2" fontsize=13 penwidth=1.6];
  j  [label="MODEL · a DIFFERENT family, enforced in code\n“You are checking another system's work.”\nspan — is this really a reaction the writer had?\ncode — is this the right SNOMED concept for it?"
      fillcolor="#e3eeef" color="#0c6469" penwidth=2];

  subgraph cluster_c {
    label="  CADEC · rerun-cadec-d0 · 230 records · blind judge  "; fontname="Helvetica"; fontsize=12;
    color="#c8d1d5"; style=rounded; fontcolor="#5a6b73";
    cp [label="pass · 136" fillcolor="#e3f0e6" color="#2d6a4f" penwidth=2];
    cf [label="fail · 87" fillcolor="#fbe4e4" color="#a33333" penwidth=2];
    cu [label="unjudged · 7" fillcolor="#f2f4f5" fontcolor="#5a6b73"];
    cn [label="span ✗ code ✗ · 41      span ✓ code ✗ · 39\nspan ✓ code ✓ · 136      span ✗ code ✓ · 7\nHanded the number 1003722009 and never the\nconcept name or the menu — the rung 4 subsection fixes that."
        fillcolor="#fdf0c8" color="#946c00"];
    { rank=same; cp; cf; cu }
    cp -> cn [style=invis]; cf -> cn [style=invis];
  }

  subgraph cluster_f {
    label="  FiNER · rerun-finer-d0 · 304 records · blind judge  "; fontname="Helvetica";
    fontsize=12; color="#c8d1d5"; style=rounded; fontcolor="#5a6b73";
    fp [label="pass · 45" fillcolor="#e3f0e6" color="#2d6a4f" penwidth=2];
    ff [label="fail · 251" fillcolor="#fbe4e4" color="#a33333" penwidth=2];
    fu [label="unjudged · 8" fillcolor="#f2f4f5" fontcolor="#5a6b73"];
    fn [label="span ✗ code ✗ · 141      span ✓ code ✗ · 102\nspan ✓ code ✓ ·  45      span ✗ code ✓ ·   8\nIt answers BOTH questions — here the code
IS a name: DebtInstrumentFaceAmount."
        fillcolor="#e3f0e6" color="#2d6a4f"];
    { rank=same; fp; ff; fu }
    fp -> fn [style=invis]; ff -> fn [style=invis];
  }

  dead [label="r4_verdict\nONE reader in the whole system, and it is off by default"
        fillcolor="#fbe4e4" color="#a33333" penwidth=2.5];

  in -> j; j -> cp; j -> cf; j -> cu; j -> fp; j -> ff; j -> fu;
  cn -> dead [style=dashed color="#a33333"]; fn -> dead [style=dashed color="#a33333"];

  note [shape=plaintext style="" fillcolor="white"
        label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3">
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5a6b73"><B>Same model, same rung, two corpora — and blind, it can barely do its job on either.</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5a6b73">We read that as the limit of a 3.2B judge for five phases. It was a property of our prompt:</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5a6b73">the judge was never shown the concept&#39;s name, the menu, or the line the extractor picked.</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#a33333"><B>And on neither corpus did any of it change a shipped answer.</B> 84,000 tokens a run on CADEC and 270,000 on FiNER to write</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#a33333">a field whose only reader is a flag we measured and left off. See “What each layer was for”.</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#fbe4e4"><FONT POINT-SIZE="11" COLOR="#a33333"><B>THESE ARE THE BLIND JUDGE&#39;S COUNTS.</B> Shown the menu, the same model separates 3.4-4.2x on CADEC</FONT></TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#fbe4e4"><FONT POINT-SIZE="11" COLOR="#a33333">against 1.7x here, and stops failing to parse. The paired table is in the rung 4 subsection.</FONT></TD></TR>
        </TABLE>>];
  dead -> note [style=invis];
}
