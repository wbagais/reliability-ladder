// The same 230 records, sorted by the same rung 1, under the two settings of
// lexical_mode: rerun-cadec-d0 and its lexarm replay on the same cache
// (2026-09-03), rung 1 state rows, correctness span-exact.
//
// This is the eleven points, in records rather than percentages: contained adds
// 38 to the ACCEPT lane, 15 of which are correct.
//
// COLOUR KEY — the article's zone colours:
//   green #2d6a4f ACCEPT   amber #946c00 BAND   grey a stage
digraph lexmode {
  rankdir=TB; bgcolor="white";
  node [shape=box style="filled,rounded" fontname="Helvetica" fontsize=12
        color="#c8d1d5" penwidth=1.2];
  edge [color="#b3bec3" penwidth=1.5 arrowsize=0.7 fontname="Helvetica" fontsize=11];

  in [label="the same 230 records\nthe same four checks" fillcolor="#eef1f2" fontsize=13 penwidth=1.6];

  ex [label="lexical_mode = exact\nthe strings must be identical" fillcolor="#e3f0e6" color="#2d6a4f" penwidth=2];
  co [label="lexical_mode = contained\none word-set inside the other" fillcolor="#f2f4f5" color="#8a9aa1" penwidth=2 style="filled,rounded,dashed"];

  exa [label="ACCEPT · 53\n40 correct · 1 wrong · 12 off-span (4 on no gold)\n75.5% correct"
       fillcolor="#e3f0e6" color="#2d6a4f" penwidth=2.5];
  exb [label="BAND · 175\n26.9% correct" fillcolor="#fdf0c8" color="#946c00" penwidth=2];

  coa [label="ACCEPT · 91\n55 correct · 3 wrong · 33 off-span (12 on no gold)\n60.4% correct"
       fillcolor="#f4f9f6" color="#8a9aa1" penwidth=2.5];
  cob [label="BAND · 137\n23.4% correct" fillcolor="#fdfaf0" color="#b8a06a" penwidth=2];

  in -> ex [label="  SHIPPED  "]; in -> co [label="  the alternative  " style=dashed color="#c8d1d5"];
  ex -> exa; ex -> exb;
  co -> coa; co -> cob;

  { rank=same; ex; co }
  { rank=same; exa; exb; coa; cob }

  note [shape=plaintext style="" fillcolor="white"
        label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3">
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5a6b73"><B>The looser setting nearly doubles the free lane and takes 15 points off its accuracy.</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5a6b73">Of the 38 records it adds, <B>15 are correct</B> — the other 23 are wrong or sit off the gold span.</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#946c00">Note what does NOT happen: BAND's accuracy barely moves (26.9% to 23.4%). The setting</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#946c00">does not sort better — it moves the line, and mostly moves unverifiable records across it.</FONT></TD></TR>
        </TABLE>>];
  cob -> note [style=invis];
}
