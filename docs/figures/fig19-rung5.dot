// Rung 5 on CADEC dev, rerun-cadec-d0 (2026-09-03) — the refusal rung.
//
// ZERO MODEL CALLS. From the run's own rung 5 and rung 6 state rows: 230
// records, ACCEPT 53 -> VERIFIED, BAND 176 + REJECT 1 -> ABSTAIN 177.
// Correctness split span-exact, the same split fig10-rung1 reports (after
// rung 3's two overwrites).
//
// WHY ONE RULE IS DRAWN OFF AND ONE RETIRED: `abstain_on_judge_fail: false` is
// the shipped value. `tau` was RETIRED 2026-09-03: rung 0 reports >= 0.9
// confidence on every record (66% report exactly 1.0) while getting ~38% of
// them right, so the textbook abstention method was not untuned here, it was
// inapplicable.
//
// COLOUR KEY — unchanged from fig1-wiring:
//   green #2d6a4f ships/correct   amber #946c00 withheld   grey deterministic
//   NO TEAL ANYWHERE: teal marks a model call, and this rung makes none.
digraph rung5 {
  rankdir=TB; bgcolor="white";
  node [shape=box style="filled,rounded" fontname="Helvetica" fontsize=12
        color="#c8d1d5" penwidth=1.2];
  edge [color="#b3bec3" penwidth=1.5 arrowsize=0.7 fontname="Helvetica" fontsize=10];

  in [label="EVERY record still in flight · 230\nrung 1 judged but did not route, so nothing was filtered out\nverdict is CURRENT: rungs 2 and 3 re-run rung 1 after any change"
      fillcolor="#eef1f2" fontsize=13 penwidth=1.6];

  rule [shape=none margin=0 label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#f4f6f7" COLOR="#9aa7ad">
      <TR><TD COLSPAN="2" BGCOLOR="#e9edef"><FONT POINT-SIZE="13"><B>RUNG 5 · no model call, no answer key</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">1 · verdict is REJECT</FONT></TD>
          <TD ALIGN="LEFT"><FONT POINT-SIZE="11">withhold</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#98a3a8">2 · the judge failed it</FONT></TD>
          <TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#98a3a8"><B>OFF</B>  abstain_on_judge_fail</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#98a3a8">3 · confidence below tau</FONT></TD>
          <TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#98a3a8"><B>RETIRED</B>  no threshold separates anything</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">4 · verdict is BAND</FONT></TD>
          <TD ALIGN="LEFT"><FONT POINT-SIZE="11">withhold</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">5 · verdict is ACCEPT</FONT></TD>
          <TD ALIGN="LEFT"><FONT POINT-SIZE="11">ship</FONT></TD></TR>
      <TR><TD COLSPAN="2" BGCOLOR="#e9edef" ALIGN="LEFT"><FONT POINT-SIZE="11"><B>With one rule off and one retired, the whole rung is: ship ACCEPT, withhold the rest.</B></FONT></TD></TR>
    </TABLE>>];

  ship [label="VERIFIED · 53 ship\n39 correct · 2 wrong code · 12 off the gold span (4 on no gold)\naccuracy on what it answers = 73.6%"
        fillcolor="#e3f0e6" color="#2d6a4f" penwidth=2.5];

  hold [label="ABSTAIN · 177 withheld → a person\n49 correct · 26 wrong code · 102 off the gold span (40 on no gold)\nreason: unresolved · answer kept in checks.withheld"
        fillcolor="#fdf0c8" color="#946c00" penwidth=2.5];

  note [shape=none margin=0 label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11"><B>It does not resolve. It sorts.</B> Coverage falls 230 → 53 (23.0%).</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Accuracy on answered records rises 38.3% → <B>73.6%</B> — but it withdrew <B>49 correct answers</B> to remove 128 wrong ones.</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Counted as <B>yield</B> (correct ÷ every record), the same step reads <B>38.3% → 17.0%</B>. Precision rises because abstaining always raises precision.</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Withheld, never deleted: the proposed code is preserved so rung 6 can show a person what the system was going to say.</FONT></TD></TR>
    </TABLE>>];

  in -> rule [penwidth=2];
  rule -> ship [label="  ACCEPT " color="#2d6a4f" penwidth=2.2];
  rule -> hold [label="  BAND / REJECT " color="#946c00" penwidth=2.2];
  ship -> note [style=invis];
  hold -> note [style=invis];
  {rank=same; ship; hold;}
}
