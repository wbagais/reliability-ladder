// Rung 3 on CADEC dev, rerun-cadec-d0 (2026-09-03), from the per-record state
// table (ladder/analysis.r3_crosstab, out/rerun/cadec.json):
//   230 records, 12 never re-found, 4 seen once, 214 with >=2 votes:
//   149 agree with the record's code, 25 split 2-1 keeping it, 15 tied,
//   25 changed (22 BAND, 2 ACCEPT, 1 REJECT). Net correct +1: 3 gained, 2 destroyed.
// Draws 1 and 2: changed 28 / 27, net -1 / -1, destroyed 3 / 5.
//
// COLOUR KEY — the article's: green correct · red wrong or lost · grey a stage
digraph rung3 {
  rankdir=TB; bgcolor="white"; nodesep=0.30; ranksep=0.36;
  node [shape=box style="filled,rounded" fontname="Helvetica" fontsize=12
        color="#c8d1d5" penwidth=1.2];
  edge [color="#b3bec3" penwidth=1.5 arrowsize=0.7 fontname="Helvetica" fontsize=10];

  in [label="EVERY record, every lane\n230" fillcolor="#eef1f2" fontsize=13 penwidth=1.6];
  s  [label="MODEL ×3 · re-extract every document\ntemperature 0.7 · 410,638 tokens · 2.5× rung 0"
      fillcolor="#e3eeef" color="#0c6469" penwidth=2];

  nf [label="never re-found\n12   (5%)\nrung 0 had: 9 on no gold · 2 correct · 1 wrong" fillcolor="#fbe4e4" color="#a33333" penwidth=2];
  one[label="found by one sample only\n4 — a single vote is not a vote,\nso no change is allowed"
      fillcolor="#fdf0c8" color="#946c00"];
  two[label="found by 2 or 3 samples\n214" fillcolor="#e3f0e6" color="#2d6a4f" penwidth=2];

  un [label="ALL VOTES AGREE with rung 0\n149   (69.6%)" fillcolor="#e3f0e6" color="#2d6a4f" penwidth=2];
  sp [label="SPLIT 2–1, code kept\n25" fillcolor="#fdf0c8" color="#946c00" penwidth=2];
  ti [label="TIED, no majority\n15" fillcolor="#fdf0c8" color="#946c00" penwidth=2];

  ch [label="25 codes actually changed\n22 in BAND · 2 in ACCEPT · 1 in REJECT" fillcolor="#eef1f2" penwidth=1.6];

  band [label="from a record with NO CODE\n∴ BAND, by construction · 1\n1 → incorrect"
        fillcolor="#e3f0e6" color="#2d6a4f" penwidth=2];
  unk  [label="from a record with a WRONG code · 5\n3 → correct · 2 → still wrong"
        fillcolor="#fdf0c8" color="#946c00" penwidth=2];
  nog  [label="on records matching no gold\n17 — invented before and after"
        fillcolor="#f2f4f5" fontcolor="#5a6b73"];

  safe [label="correct → incorrect\n2 in this run — one of them ACCEPT, and it shipped\n3 and 5 on draws 1 and 2 · 11 in the baseline"
        fillcolor="#e3f0e6" color="#2d6a4f" penwidth=2.5];

  in -> s; s -> nf; s -> one; s -> two;
  two -> un; two -> sp; two -> ti;
  un -> ch; sp -> ch;
  ch -> band; ch -> unk; ch -> nog;
  band -> safe [style=invis]; unk -> safe [style=invis];
  { rank=same; nf; one; two }
  { rank=same; un; sp; ti }
  { rank=same; band; unk; nog }

  note [shape=plaintext style="" fillcolor="white"
        label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3">
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5a6b73"><B>Three more extractions, +1 net correct answer.</B> 410,638 tokens for one record, and the</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5a6b73">model disagrees with itself on 30% of what it re-finds and cannot re-find 5% of it at all.</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#2d6a4f"><B>Did voting ever make a right answer wrong? Yes, and it still does.</B> The baseline destroyed</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#2d6a4f">11 correct answers; an earlier run overwrote 9 of 32 verified codes on a 1-0 "majority"; this run</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#2d6a4f">destroys 2, and draws 1 and 2 destroy 3 and 5. The repairs reduced it; nothing removes it.</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#946c00"><B>It never reads rung 1's verdict.</B> The same three extractions are paid for the 53 records the</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#946c00">free check already settled and the 175 heading for abstention.</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#a33333"><B>Every row is now broken down by what rung 0 had said.</B> The 12 it could not re-find were mostly</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#a33333">invented spans (9 of 12); 17 of its 25 changes replace one wrong code with another on a span that</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#a33333">matches no gold mention. Voting is not fixing what was broken; it is re-coding the</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#a33333">extractor's false positives, in the lane where the free check had no opinion. See the rung 3 subsection.</FONT></TD></TR>
        </TABLE>>];
  safe -> note [style=invis];
}
