digraph loop {
  rankdir=TB;
  bgcolor="white";
  node [shape=box style="rounded,filled" fontname="Helvetica" fontsize=13
        margin="0.26,0.16" fillcolor="#ffffff" color="#444444" penwidth=1.6];
  edge [fontname="Helvetica" fontsize=11 color="#555555" penwidth=1.3];
  graph [nodesep=0.4 ranksep=0.42];

  A [label="Build the rung on a plausible mechanism"];
  B [label="Measure it against the answer key\nbefore trusting it" fillcolor="#e3f0e6" color="#2d6a4f" penwidth=2.2];
  C [label="When the number looks good, doubt it\nthree draws · a held-out split · a gold control"
     fillcolor="#fdf0c8" color="#946c00" penwidth=2.2];
  D [label="When it fails, keep the fix and lose the finding"
     fillcolor="#fbe4e4" color="#a33333" penwidth=2.2];
  E [label="Re-measure the layers above\nwhen you change one below"];

  A -> B -> C -> D -> E;
  E -> A [constraint=false color="#2d6a4f" penwidth=2
          label="  every dead rung in this article\l  was found on this loop\l"
          fontcolor="#2d6a4f" fontsize=11];
}
